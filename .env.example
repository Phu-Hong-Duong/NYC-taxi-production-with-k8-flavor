# Shape of every secret/endpoint the stack needs. Copy to .env and fill locally.
# Real values NEVER enter git (protocol PROTECTED rule). Generate passwords locally.
#
# You do not normally fill this in by hand: `make deploy-platform` runs
# scripts/platform_secrets.sh, which generates .env with random passwords on
# first use and then treats it as the source of truth for every Kubernetes
# Secret. Keep it — the passwords are baked into the Postgres data directory and
# the MinIO volume, which is why cluster.sh's destroy DENY list protects it.
#
# The URLs are the HOST routes (kind maps them from NodePorts — see
# infra/kind/kind-config.yaml). Inside the cluster the same services are
# postgres.platform.svc:5432, minio.platform.svc:9000, mlflow.mlflow.svc:5000.

# MinIO admin account — administration only; nothing in the stack uses it to
# read or write data.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# The MinIO identity MLflow (and every client that reads artifacts) uses.
# AWS_ACCESS_KEY_ID is a username, and its value is a twin of the `accessKey` in
# infra/helm/minio/values.yaml — platform_secrets.sh refuses to run if they drift.
# Needed in the local shell AND in training pods AND in Flyte tasks (gotcha #5).
AWS_ACCESS_KEY_ID=mlflow
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Postgres superuser (role `postgres`) — schema administration.
POSTGRES_PASSWORD=

# MLflow's own database role, owner of database `mlflow`.
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=

# The dbt gold marts' database role, owner of database `marts` (M1-S4, D-002).
# Created on an ALREADY-INITIALISED volume by scripts/postgres_databases.sh —
# docker-entrypoint-initdb.d only ever runs on an empty data directory, so the
# second database in the one Postgres cannot arrive the way the first one did.
MARTS_DB_USER=marts
MARTS_DB_PASSWORD=

# Grafana's admin login (M6-S1). Read by the grafana chart out of the Secret
# `monitoring/grafana-admin`, never passed with `--set`. Anonymous viewers can
# read the boards without it; this credential is what it costs to EDIT one.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
